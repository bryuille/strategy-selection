# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Mac
.DS_Store

# Data
data/mat/
data/npz/
data/processed/

# Config
.matplotlib/
.claude/
# Slurm job logs
/logs/

# Sandbox-local tool caches (kept in-repo so no ~ carve-out is needed)
.uv-cache/
.mplconfig/

# Ruff's own default cache location -- not configured by this project, it
# appears whenever an editor extension or `uvx ruff` runs here. Ruff already
# self-ignores (it writes a `*` .gitignore inside the dir), so this line is
# for visibility rather than effect.
.ruff_cache/

# SSH control socket (host-local, never shared)
.ssh-sockets/

# Figures. Generated on the cluster, pulled down explicitly, never tracked.
# A `git add -A` after a pull once committed 4482 saccade PNGs (722 MB),
# undoing the history rewrite that took .git from 2.4 GB to 22 MB. The CSVs
# under classifier/out/ are real results and stay tracked, so this ignores
# image formats rather than the out/ directories themselves.
# **/out/**/*.png
**/out/**/*.mp4
**/out/**/*.pdf
**/out/**/*.svg
