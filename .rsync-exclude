# Push code up (run from the repo root):
#   rsync -av --delete --exclude-from=.rsync-exclude ./ \
#       byuille@orcd-login.mit.edu:/home/byuille/strategy-selection/
#
# Pull results back:
#   rsync -av byuille@orcd-login.mit.edu:/home/byuille/strategy-selection/eye_pre_flash/classifier/out/ \
#       ./eye_pre_flash/classifier/out/
#
# --delete removes dest files that are gone locally. Do not add
# --delete-excluded (that would wipe dest data/mat/).
#
# Figures are EXCLUDED from the push, so a `--delete` push can never destroy
# the cloud's. That is not a nicety: figures stopped being tracked in git when
# the PNG history was stripped, so this checkout will never hold them, and a
# push that made the cloud match it wiped 4482 freshly-computed figures once
# already. Code goes up, figures come down, and the two directions no longer
# fight.
#
# Pulls are unaffected -- they name an explicit path rather than reading this
# file, so `rsync -av engaging:.../saccades/out/ ./...` still works.
#
# Leading '/' = repo root. Unanchored '*.mat' / '*.npz' catch strays.

# Raw and derived data. The cloud already has data/mat/; everything else in
# here is rebuilt there by `python -m eye_pre_flash.classifier.pipeline`.
/data/mat/
/data/npz/
/data/processed/
/data/archive/

# Local env and caches (the cloud runs its own `uv sync`)
.venv/
.git/
.matplotlib/
.ruff_cache/
.DS_Store

# Strays. Note *.mat also covers zrefs/Dendogram_all/, which the classifier
# pipeline does not need; drop this line if you want the label check up there.
*.mat
*.npz

# Movies are large and are not figures. Remove if you want them synced.
*.mp4

# Logs
/logs/

# Sandbox-local tool caches; the cluster builds its own
/.uv-cache/
/.mplconfig/

# SSH control socket; host-local
/.ssh-sockets/

# Per-host Claude Code overrides (e.g. cluster-only permission hooks).
# .claude/settings.json itself still syncs; only the local override does not.
/.claude/settings.json

