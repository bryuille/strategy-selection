# Push code up (from the repo root):
#   rsync -av --delete --exclude-from=.rsync-exclude ./ \
#       byuille@orcd-login.mit.edu:/home/byuille/strategy-selection/
#
# Pull results back with an explicit path (this file is for pushes only):
#   rsync -av engaging:strategy-selection/msp/out/ ./msp/out/
#
# --delete removes dest files that are gone locally. Do not add
# --delete-excluded: that would wipe dest data/mat/.
#
# Figures are excluded from the push so a `--delete` push cannot destroy
# cluster-side outputs that are not in this checkout.
#
# Leading '/' = repo root. Unanchored '*.mat' / '*.npz' catch strays.

